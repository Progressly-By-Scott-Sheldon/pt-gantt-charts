page 3 (
    name: Bar chart (moved)
    alias: BAR-CHART
    title: Bar chart
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: false
    }

    process redirect-to-schedule-gantt (
        name: Redirect to Schedule Gantt
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- This page was removed; old links and bookmarks land on the Schedule Gantt.
                apex_util.redirect_url(apex_page.get_url(p_page => 4));
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

)
