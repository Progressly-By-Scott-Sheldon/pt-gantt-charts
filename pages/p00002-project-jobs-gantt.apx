page 2 (
    name: Project - Jobs Gantt
    alias: PROJECT-JOBS-GANTT
    title: Project - Jobs Gantt
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region project-jobs-gantt (
        name: Project - Jobs Gantt
        type: chart
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chart {
            type: gantt
        }
        chartLayout {
            height: 400
        }

        series series-1 (
            name: Series 1
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                        'R' || TO_CHAR(JobId)                                   AS ROW_ID,
                        CASE WHEN INSTR(Notes, '_') > 0
                             THEN SUBSTR(Notes, 1, INSTR(Notes, '_') - 1)
                             ELSE Notes
                        END                                                     AS PROJECT,
                        'T' || TO_CHAR(JobId)                                   AS TASK_ID,
                        'Job ' || JobId || ' - ' || Name                        AS TASK_NAME,
                        CAST(ScheduledStartDateTime AS DATE)                    AS START_DATE,
                        CAST(ScheduledEndDateTime   AS DATE)                    AS END_DATE,
                        ROUND(CAST(ScheduledEndDateTime AS DATE)
                            - CAST(ScheduledStartDateTime AS DATE), 1)          AS DURATION_DAYS,
                        'Job ' || JobId || ' | ' || Name || ' | '
                            || TO_CHAR(CAST(ScheduledStartDateTime AS DATE), 'DD-Mon-YY HH24:MI') || ' to '
                            || TO_CHAR(CAST(ScheduledEndDateTime   AS DATE), 'DD-Mon-YY HH24:MI')
                            || ' (' || ROUND(CAST(ScheduledEndDateTime AS DATE)
                                     - CAST(ScheduledStartDateTime AS DATE), 1) || ' d)'  AS TOOLTIP
                    FROM PT_Jobs
                    WHERE Scheduled = 1
                      AND ScheduledEndDateTime > ScheduledStartDateTime
                    ```
            }
            orderBy {
                type: staticValue
                orderByClause: Project, Start_Date, End_Date
            }
            timeline {
                startDateSourceType: databaseColumn
                startDateColumn: START_DATE
                endDateSourceType: databaseColumn
                endDateColumn: END_DATE
            }
            columnMapping {
                rowName: PROJECT
                taskId: TASK_ID
                taskName: TASK_NAME
                taskStartDate: START_DATE
                taskEndDate: END_DATE
            }
            label {
                show: true
            }
        )

        axis major (
            name: major
            timeScale {
                scale: months
            }
        )

        axis minor (
            name: minor
            timeScale {
                scale: days
            }
            zoomScale {
                quarters: false
            }
            value {
                format: decimal
            }
        )

    )

)

