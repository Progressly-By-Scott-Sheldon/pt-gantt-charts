page 5 (
    name: Schedule Data
    alias: SCHEDULE-DATA
    title: Schedule Data
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region import-jobs (
        name: Import Jobs
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <style>.sd-info{float:right;position:relative;margin:8px 4px 0 16px;display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;border:1px solid currentColor;color:var(--ut-component-text-muted-color,#6b6b6b);font:italic 600 13px/1 Georgia,serif;cursor:help;z-index:5}.sd-info:hover,.sd-info:focus-visible{color:var(--ut-palette-primary,#0572ce);outline:none}.sd-info .sd-pop{display:none;position:absolute;top:calc(100% + 8px);right:-6px;width:min(460px,85vw);padding:10px 12px;border-radius:8px;background:var(--ut-component-background-color,#fff);color:var(--ut-body-text-color,#262626);border:1px solid var(--ut-component-border-color,#ddd);box-shadow:0 6px 24px rgba(0,0,0,.18);font:400 13px/1.5 var(--a-base-font-family,inherit);font-style:normal;text-align:left}.sd-info .sd-pop p{margin:0 0 8px}.sd-info .sd-pop p:last-child{margin:0}.sd-info:hover .sd-pop,.sd-info:focus .sd-pop{display:block}</style><span class="sd-info" tabindex="0" role="button" aria-label="About jobs">i<span class="sd-pop" role="tooltip"><p>Upload the PlanetTogether Jobs export (.xlsx) to replace PlanetTogether's jobs below. Rows you added by hand are kept. Only the columns the Gantt needs are shown; the rest are stored as they are.</p><p>One row per job. Project groups the jobs on the Schedule Gantt (for example Project 1). Add the job here first, then its operations below. Rows you add are kept when a new PlanetTogether export is loaded; changes to rows that came from PlanetTogether are replaced by the next load.</p></span></span>
                ```
        }
    )

    pageItem P5_JOBS_FILE (
        type: fileUpload
        label {
            label: Jobs export (.xlsx)
            alignment: left
        }
        storage {
            type: appTempFiles
            purgeFileAt: endOfRequest
            maxFileSize: 10000
        }
        layout {
            sequence: 10
            region: @import-jobs
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
    )

    button import-jobs (
        buttonName: IMPORT_JOBS
        label: Import Jobs
        layout {
            sequence: 20
            region: @import-jobs
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-upload
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process import-jobs (
        name: Import Jobs
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_blob BLOB;
                    l_name VARCHAR2(400);
                    l_msg  VARCHAR2(4000);
                BEGIN
                    IF :P5_JOBS_FILE IS NULL THEN
                        apex_error.add_error(p_message => 'Choose the PlanetTogether Jobs export (.xlsx) first.',
                                             p_display_location => apex_error.c_inline_in_notification);
                        RETURN;
                    END IF;
                    SELECT blob_content, filename INTO l_blob, l_name
                      FROM apex_application_temp_files
                     WHERE name = :P5_JOBS_FILE;
                    -- Replaces PlanetTogether's rows in PT_JOBS, keeps rows added by hand (see db/pt_import.sql).
                    pt_import.import_xlsx('PT_JOBS', l_blob, l_name, l_msg);
                    apex_application.g_print_success_message := apex_escape.html(l_msg);
                EXCEPTION
                    WHEN OTHERS THEN
                        apex_error.add_error(p_message => regexp_replace(sqlerrm, '^ORA-[0-9]+: ', ''),
                                             p_display_location => apex_error.c_inline_in_notification);
                END;
                ```
        }
        execution {
            sequence: 5
        }
        serverSideCondition {
            whenButtonPressed: @import-jobs
        }
    )

    region import-operations (
        name: Import Operations
        type: staticContent
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <span class="sd-info" tabindex="0" role="button" aria-label="About operations">i<span class="sd-pop" role="tooltip"><p>Upload the PlanetTogether Operations export (.xlsx) to replace PlanetTogether's operations below. Rows you added by hand are kept. Only the columns the Gantt needs are shown; the rest are stored as they are.</p><p>One row per operation: each is a bar on the Schedule Gantt. Name is the operation (Cutting, Bending ...), External ID its sequence (Op010, Op020 ...). Pick one or more resources. Late is worked out from Scheduled End and Need Date when you save. Rows you add are kept when a new PlanetTogether export is loaded; changes to rows that came from PlanetTogether are replaced by the next load.</p></span></span>
                ```
        }
    )

    pageItem P5_OPERATIONS_FILE (
        type: fileUpload
        label {
            label: Operations export (.xlsx)
            alignment: left
        }
        storage {
            type: appTempFiles
            purgeFileAt: endOfRequest
            maxFileSize: 10000
        }
        layout {
            sequence: 10
            region: @import-operations
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
    )

    button import-operations (
        buttonName: IMPORT_OPERATIONS
        label: Import Operations
        layout {
            sequence: 20
            region: @import-operations
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-upload
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process import-operations (
        name: Import Operations
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_blob BLOB;
                    l_name VARCHAR2(400);
                    l_msg  VARCHAR2(4000);
                BEGIN
                    IF :P5_OPERATIONS_FILE IS NULL THEN
                        apex_error.add_error(p_message => 'Choose the PlanetTogether Operations export (.xlsx) first.',
                                             p_display_location => apex_error.c_inline_in_notification);
                        RETURN;
                    END IF;
                    SELECT blob_content, filename INTO l_blob, l_name
                      FROM apex_application_temp_files
                     WHERE name = :P5_OPERATIONS_FILE;
                    -- Replaces PlanetTogether's rows in PT_JOB_OPERATIONS, keeps rows added by hand (see db/pt_import.sql).
                    pt_import.import_xlsx('PT_JOB_OPERATIONS', l_blob, l_name, l_msg);
                    apex_application.g_print_success_message := apex_escape.html(l_msg);
                EXCEPTION
                    WHEN OTHERS THEN
                        apex_error.add_error(p_message => regexp_replace(sqlerrm, '^ORA-[0-9]+: ', ''),
                                             p_display_location => apex_error.c_inline_in_notification);
                END;
                ```
        }
        execution {
            sequence: 15
        }
        serverSideCondition {
            whenButtonPressed: @import-operations
        }
    )

    region pt-jobs (
        name: Jobs
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: PT_JOBS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: scroll
        }
        toolbar {
            controls: [
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 300
        }

        savedReport 9100005 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @EXTERNALID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @NAME
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @NOTES
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @PRODUCT
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @QTY
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @NEEDDATETIME
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @JOBID
                layout {
                    sequence: 7
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
        )

        column EXTERNALID (
            type: textField
            heading {
                heading: Job ID
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
                maxLength: 50
            }
            source {
                databaseColumn: EXTERNALID
                dataType: varchar2
            }
        )

        column NAME (
            type: textField
            heading {
                heading: Job Name
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
                maxLength: 255
            }
            source {
                databaseColumn: NAME
                dataType: varchar2
            }
        )

        column NOTES (
            type: textField
            heading {
                heading: Project
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
                maxLength: 4000
            }
            source {
                databaseColumn: NOTES
                dataType: varchar2
            }
        )

        column PRODUCT (
            type: textField
            heading {
                heading: Product
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 255
            }
            source {
                databaseColumn: PRODUCT
                dataType: varchar2
            }
        )

        column QTY (
            type: numberField
            heading {
                heading: Qty
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                databaseColumn: QTY
                dataType: number
            }
        )

        column NEEDDATETIME (
            type: datePicker
            heading {
                heading: Need Date
            }
            settings {
                showTime: true
            }
            layout {
                sequence: 90
            }
            appearance {
                formatMask: DD-MM-YYYY HH24:MI
            }
            source {
                databaseColumn: NEEDDATETIME
                dataType: timestamp
            }
        )

        column JOBID (
            type: displayOnly
            heading {
                heading: Job No
            }
            layout {
                sequence: 100
            }
            source {
                databaseColumn: JOBID
                dataType: number
                queryOnly: true
            }
        )
    )

    region pt-operations (
        name: Operations
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: PT_JOB_OPERATIONS
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: scroll
        }
        toolbar {
            controls: [
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 400
        }

        savedReport 9100006 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @JOBID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @EXTERNALID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @NAME
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @PRODUCTSLIST
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @SCHEDULEDSTART
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @SCHEDULEDEND
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @NEEDDATE
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @RESOURCESUSED
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @LATE_YN
                layout {
                    sequence: 9
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
        )

        column JOBID (
            type: popupLov
            heading {
                heading: Job
            }
            lov {
                type: sqlQuery
                sqlQuery: SELECT externalid || ' · ' || name d, jobid r FROM pt_jobs ORDER BY externalid
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: JOBID
                dataType: number
            }
        )

        column EXTERNALID (
            type: textField
            heading {
                heading: External ID
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: EXTERNALID
                dataType: varchar2
            }
        )

        column NAME (
            type: textField
            heading {
                heading: Name
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
                maxLength: 4000
            }
            source {
                databaseColumn: NAME
                dataType: varchar2
            }
        )

        column PRODUCTSLIST (
            type: textField
            heading {
                heading: Product List
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: PRODUCTSLIST
                dataType: varchar2
            }
        )

        column SCHEDULEDSTART (
            type: datePicker
            heading {
                heading: Scheduled Start
            }
            settings {
                showTime: true
            }
            layout {
                sequence: 80
            }
            appearance {
                formatMask: DD-MM-YYYY HH24:MI
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: SCHEDULEDSTART
                dataType: date
            }
        )

        column SCHEDULEDEND (
            type: datePicker
            heading {
                heading: Scheduled End
            }
            settings {
                showTime: true
            }
            layout {
                sequence: 90
            }
            appearance {
                formatMask: DD-MM-YYYY HH24:MI
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: SCHEDULEDEND
                dataType: date
            }
        )

        column NEEDDATE (
            type: datePicker
            heading {
                heading: Need Date
            }
            settings {
                showTime: true
            }
            layout {
                sequence: 100
            }
            appearance {
                formatMask: DD-MM-YYYY HH24:MI
            }
            source {
                databaseColumn: NEEDDATE
                dataType: date
            }
        )

        column RESOURCESUSED (
            type: popupLov
            heading {
                heading: Resources
            }
            lov {
                type: sqlQuery
                sqlQuery: SELECT resource_name || ' (' || department_name || ')' d, resource_name r FROM pt_resources ORDER BY department_name, resource_name
            }
            multipleValues {
                type: delimitedList
                separator: ,
            }
            layout {
                sequence: 110
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: RESOURCESUSED
                dataType: varchar2
            }
        )

        column LATE_YN (
            type: displayOnly
            heading {
                heading: Late
            }
            layout {
                sequence: 120
            }
            source {
                databaseColumn: LATE_YN
                dataType: varchar2
                queryOnly: true
            }
        )
    )

    process save-pt-jobs (
        name: Jobs - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @pt-jobs
        execution {
            sequence: 10
        }
    )

    process save-pt-operations (
        name: Operations - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @pt-operations
        execution {
            sequence: 20
        }
    )

)
