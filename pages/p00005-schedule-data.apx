        column PRODUCTION_STATUS (
            type: selectList
            heading {
                heading: Status
            }
            lov {
                type: staticValues
                staticValues: STATIC:Ready;Ready,Waiting;Waiting,Started;Started,Finished;Finished
                displayExtraValues: true
                displayNullValue: false
            }
            layout {
                sequence: 110
            }
